# --- PyInstaller / build output ---
# build/ holds the committed control panel (Manage-RamOptimizer.bat +
# RamOptimizerControl.ps1). Everything PyInstaller and CI drop in there is
# ignored, so the folder stays small and reviewable.
build/*.zip
release/
installer/Output/
installer/*.exe
*.spec.bak
version_info_stamp.py

